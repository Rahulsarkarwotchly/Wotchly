{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    { "name": "VITE_FIREBASE_API_KEY", "description": "Firebase Web API key (Firebase console → Project settings → General → Web app config)", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_AUTH_DOMAIN", "description": "Firebase auth domain, e.g. <project>.firebaseapp.com", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_DATABASE_URL", "description": "Firebase Realtime Database URL, e.g. https://<project>-default-rtdb.firebaseio.com", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_PROJECT_ID", "description": "Firebase project ID", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_STORAGE_BUCKET", "description": "Firebase storage bucket, e.g. <project>.appspot.com", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_MESSAGING_SENDER_ID", "description": "Firebase messaging sender ID (Web app config)", "requiredAtBoot": true, "generatedForDevelopment": false },
    { "name": "VITE_FIREBASE_APP_ID", "description": "Firebase Web app ID (Web app config)", "requiredAtBoot": true, "generatedForDevelopment": false }
  ]
}
