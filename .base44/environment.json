{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "VITE_FIREBASE_API_KEY",
      "description": "Firebase project API key (Firebase console → Project settings → Web API key)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_AUTH_DOMAIN",
      "description": "Firebase auth domain, e.g. your-project.firebaseapp.com",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_DATABASE_URL",
      "description": "Firebase Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_PROJECT_ID",
      "description": "Firebase project ID",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_STORAGE_BUCKET",
      "description": "Firebase storage bucket, e.g. your-project.appspot.com",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_MESSAGING_SENDER_ID",
      "description": "Firebase messaging sender ID (Firebase console → Project settings → Cloud Messaging)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_FIREBASE_APP_ID",
      "description": "Firebase app ID (Firebase console → Project settings → General → App ID)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    }
  ]
}
