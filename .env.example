# Copy this file to .env and fill in your values.
# On Netlify, add these as Environment Variables (Site settings → Environment variables).

# ── Firebase ────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── MovieBox API ────────────────────────────────────────────────
# The base URL of your Render/backend MovieBox API server.
# On Netlify this MUST be set as a server-side env var (no VITE_ prefix)
# so the Netlify function can read it. The browser never sees this value.
#   Netlify env var name:  MOVIEBOX_API_URL
#   Example:               https://your-api.onrender.com
MOVIEBOX_API_URL=https://your-moviebox-api.onrender.com

# Optional: set this for local Vite dev so you can test the API directly.
# VITE_MOVIEBOX_API_URL=https://your-moviebox-api.onrender.com
