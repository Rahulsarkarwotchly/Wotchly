# Wotchly — Environment variables
#
# Firebase client credentials (Firebase console → Project settings →
# General → Your apps → Web app → Config). Room sync (rooms, chat,
# presence) runs on Firebase Realtime Database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
